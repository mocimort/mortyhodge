# Copy to .env and fill in. NEVER commit .env.

# ServiceTitan developer app (developer.servicetitan.io)
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=

# Anthropic API (console.anthropic.com) — used by the enrichment step
ANTHROPIC_API_KEY=

# Where the pipeline writes (default: ./data inside this folder)
KE_DATA_DIR=./data
